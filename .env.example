# Repo root — read by docker-compose.yml when it starts PostgreSQL.
# These two create the database user; DATABASE_URL below must match them.
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Each app also needs its OWN .env file; this one is not shared with them.
# See apps/deck-builder-api/.env.example and apps/deck-builder-web/.env.example

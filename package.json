{
  "name": "next-deck-builder-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "generate": "turbo run generate",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@turbo/gen": "^1.12.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4"
  },
  "packageManager": "yarn@1.22.19"
}

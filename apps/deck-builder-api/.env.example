# apps/deck-builder-api/.env
#
# Loaded by @nestjs/config at runtime and by prisma.config.ts for migrations
# and seeding. Both resolve .env relative to THIS directory, not the repo root,
# so a root-level .env will not be picked up.
#
# The credentials must match POSTGRES_USER / POSTGRES_PASSWORD in the root .env,
# since those are what create the database user.
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/deckbuilder
